# ---------------------------------------------------------------------------
# AfterKey environment configuration (EXAMPLE — placeholders only)
# Copy to .env.local for development. Never commit real secrets.
# Docs: docs/setup.md, docs/deploy.md, docs/integrations.md
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Public origin of the app (used for links in emails, origin checks).
APP_URL=http://localhost:3001
# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Use a least-privilege role in production.
DATABASE_URL=postgresql://afterkey:afterkey@127.0.0.1:5432/afterkey
# Separate role used by migrations (owner of schema objects) in production.
# DATABASE_MIGRATION_URL=postgresql://afterkey_migrator:***@127.0.0.1:5432/afterkey

# --- Secrets (REQUIRED in production; development has an explicit dev-only key) -
# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The known development key below is BLOCKED when NODE_ENV=production.
AFTERKEY_ENCRYPTION_KEY=ZGV2LW9ubHktZGV2LW9ubHktZGV2LW9ubHktZGV2MTI=
# App-wide HMAC secret (IP pseudonymization, verifiers). Required in production.
AFTERKEY_APP_SECRET=dev-only-app-secret-change-me-0000000000000000

# --- Email ------------------------------------------------------------------
# file   = writes messages to the database outbox (development / tests; the
#          message is stored but nothing leaves the machine)
# smtp   = delivers through SMTP_URL (e.g. Mailpit in dev, SES/Postmark in prod)
# resend = Resend HTTP API (RESEND_API_KEY required)
EMAIL_PROVIDER=file
EMAIL_FROM="AfterKey <no-reply@afterkey.com>"
EMAIL_ADMIN_ADDRESS=admin@afterkey.com
# SMTP_URL=smtp://user:pass@localhost:1025
# RESEND_API_KEY=

# --- Object storage ---------------------------------------------------------
# local = private directory on disk (development). s3 = any S3-compatible store.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=eu-central-1
# S3_BUCKET=afterkey-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Upload scanning --------------------------------------------------------
# URL of an HTTP malware-scanning service (POST file -> {"infected": bool}).
# In production one of MALWARE_SCAN_URL or ALLOW_UNSCANNED_UPLOADS=true is required.
# MALWARE_SCAN_URL=http://localhost:8080/scan
ALLOW_UNSCANNED_UPLOADS=true

# --- Mapping (optional) -----------------------------------------------------
# Leave MAP_PROVIDER unset to run with the address/list interface only;
# the app then shows an explicit "map not configured" notice instead of a map.
# MAP_PROVIDER=nominatim          # nominatim | maptiler | mapbox
# MAP_GEOCODE_URL=https://nominatim.openstreetmap.org/search
# MAP_GEOCODE_API_KEY=
# MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# --- Billing (optional) -----------------------------------------------------
# Without these, the app reports "billing not configured" instead of faking payments.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Background worker ------------------------------------------------------
WORKER_POLL_MS=15000
WORKER_BATCH=10
# Default delay before an automatic release executes after verification
# completes (the configurable two-hour control; tests use smaller values).
RELEASE_DELAY_SECONDS=7200

# --- Test-only controls (MUST remain false/absent in production) ------------
# Enables /api/test/* routes: simulated clock and synchronous job ticks.
# Used by the automated end-to-end suite. Never enable in production.
AFTERKEY_ENABLE_TEST_ROUTES=false
# Allows seeding the documented development accounts.
AFTERKEY_ENABLE_DEV_SEED=false
