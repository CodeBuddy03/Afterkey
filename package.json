{
  "name": "afterkey",
  "version": "0.1.0",
  "private": true,
  "description": "AfterKey — digital legacy management, secure personal vault, and controlled information release.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker/run.ts",
    "db:server": "tsx scripts/db-server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "tsx scripts/migrate.ts --database=afterkey_test",
    "db:migrate:e2e": "tsx scripts/migrate.ts --database=afterkey_e2e",
    "db:setup": "npm run db:migrate && npm run db:migrate:test && npm run db:migrate:e2e",
    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "db:setup-test": "tsx scripts/setup-test-db.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test:all"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@node-rs/argon2": "^2.2.2",
    "@scure/bip39": "^2.4.0",
    "clsx": "^2.1.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "lucide-react": "^1.59.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "^6.15.0",
    "next": "15.3.4",
    "nodemailer": "^10.1.7",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.53.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.3.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
